# ---------------------------------------------------------------------------
#  Loto Winner — environment variables
#  Copy this file to ".env" and adapt the values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Development -------------------------------------------------------------
# Port of the Flask API (default: 5000)
# LOTO_PORT=5000

# Location of the SQLite database (default: backend/loto.db)
# LOTO_DB_PATH=./loto.db

# Origins allowed for CORS (allowlist, comma-separated).
# In development, Vite (5173) is already allowed by default.
# LOTO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting: set to 0 to disable it (tests only).
# LOTO_RATELIMIT=1

# ---------------------------------------------------------------------------
# PRODUCTION — required
# ---------------------------------------------------------------------------

# Secret key: generate it with
#   python -c "import secrets; print(secrets.token_hex(32))"
LOTO_SECRET_KEY=

# Origins actually allowed (NEVER "*").
LOTO_CORS_ORIGINS=https://loto.example

# Storage for the rate-limit counter shared across workers (Redis recommended).
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# PRODUCTION — front end
# ---------------------------------------------------------------------------
# URL of the API consumed by the React build (if different from the origin).
# VITE_API_URL=https://api.loto.example
